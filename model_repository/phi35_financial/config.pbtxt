# Triton backend to use
backend: "python"

# Triton Python backend proxies requests to the validated Ollama deployment.
parameters: {
  key: "ollama_url",
  value: {string_value: "http://host.docker.internal:11434"}
}
parameters: {
  key: "ollama_model",
  value: {string_value: "phi35-financial"}
}
# The maximum number of tokens to generate in response.
# Kept conservative to avoid CPU-local timeouts through Triton -> Ollama.
parameters: {
  key: "max_output_length",
  value: {string_value: "220"}
}
parameters: {
  key: "request_timeout_seconds",
  value: {string_value: "360"}
}
parameters: {
  key: "temperature",
  value: {string_value: "0.4"}
}
parameters: {
  key: "top_p",
  value: {string_value: "0.9"}
}

# Triton should expect as input a single string of set
# length named 'text_input'
input [
  {
    name: "text_input"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

# Triton should expect to respond with a single string
# output of variable length named 'text_output'
output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]
